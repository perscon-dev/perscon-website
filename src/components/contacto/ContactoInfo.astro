---
/**
 * ContactoInfo.astro
 * Panel de información de contacto: NAP, horario, WhatsApp, servicios
 */

const canales = [
  {
    label: "WhatsApp",
    valor: "+52 55 7911 3086",
    href: "https://wa.me/5215579113086",
    target: "_blank",
    icono: "whatsapp",
    nota: "Respuesta en menos de 2 horas en horario de oficina",
  },
  {
    label: "Instagram",
    valor: "@perscon.mx",
    href: "https://www.instagram.com/perscon.mx?fbclid=IwZXh0bgNhZW0CMTAAYnJpZBExdzN5Sm9hQnV3MWZiRmUybHNydGMGYXBwX2lkEDIyMjAzOTE3ODgyMDA4OTIAAR7yctoBmSu_maHkjW3VLFpx_yzJEtRclBygR6Te8qaGXA1vuws5yrG_9rHVCg_aem_S28W0JBxJmTDNjxidcRCfw",
    target: "_blank",
    icono: "instagram",
    nota: "Síguenos para novedades y contenido informativo",
  },
  {
    label: "Correo electrónico",
    valor: "contacto@perscon.com.mx",
    href: "mailto:contacto@perscon.com.mx",
    target: "_self",
    icono: "email",
    nota: "Respuesta en menos de 24 horas hábiles",
  },
  {
    label: "Teléfono",
    valor: "+52 55 7911 3086",
    href: "tel:+525579113086",
    target: "_self",
    icono: "telefono",
    nota: "Lun–Vie 9:00–18:00 · Sáb 10:00–13:00",
  },
];

const iconPaths: Record<string, string> = {
