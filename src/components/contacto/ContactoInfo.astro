const serviciosLista = [
  "Permiso Sanitario de Construcción",
  "Licencia para Actos Quirúrgicos",
  "Licencia para Fuentes de Radiación",
  "Licencia para Bancos de Sangre",
  "Licencia para Hemodiálisis",
  "Proyectos Ejecutivos",
  "Proyectos de Obra Sector Salud",
];
---

<div class="flex flex-col gap-6">
  <!-- Canales de contacto -->
  <div
    class="border border-[var(--color-steel-200)] rounded-xl overflow-hidden"
  >
    <div
      class="px-6 py-4 bg-[var(--color-steel-50)] border-b border-[var(--color-steel-100)]"
    >
      <p
        class="text-[10px] font-semibold tracking-widest uppercase text-[var(--color-steel-500)]"
        style="font-family: var(--font-body);"
      >
        Canales de atención
      </p>
    </div>
    <ul class="divide-y divide-[var(--color-steel-100)]" role="list">
      {
        canales.map((c) => (
          <li>
            <a
              href={c.href}
              target={c.target}
              rel={c.target === "_blank" ? "noopener noreferrer" : undefined}
              class="flex items-start gap-4 px-6 py-4 hover:bg-[var(--color-steel-50)] transition-colors duration-150 group"
            >
              <div class="flex-shrink-0 w-9 h-9 rounded-lg border border-[var(--color-steel-100)] bg-white flex items-center justify-center group-hover:border-[var(--color-cofepris-200)] group-hover:bg-[var(--color-cofepris-50)] transition-colors duration-200 mt-0.5">
                <svg
                  class="w-4 h-4 text-[var(--color-steel-400)] group-hover:text-[var(--color-cofepris-700)] transition-colors duration-200"
                  fill="currentColor"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path d={iconPaths[c.icono]} />
                </svg>
              </div>
              <div class="min-w-0">
                <p
                  class="text-[10px] font-semibold tracking-widest uppercase text-[var(--color-steel-400)] mb-0.5"
                  style="font-family: var(--font-body);"
                >
                  {c.label}
                </p>
                <p
                  class="text-sm font-semibold text-[var(--color-carbon-900)] group-hover:text-[var(--color-cofepris-700)] transition-colors duration-150"
                  style="font-family: var(--font-body);"
                >
                  {c.valor}
                </p>
                <p
                  class="text-xs text-[var(--color-steel-400)] mt-0.5"
                  style="font-family: var(--font-body);"
                >
                  {c.nota}
                </p>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <!-- Horario -->
  <div class="border border-[var(--color-steel-200)] rounded-xl p-6">
    <p
      class="text-[10px] font-semibold tracking-widest uppercase text-[var(--color-steel-400)] mb-3"
      style="font-family: var(--font-body);"
    >
      Horario de atención
    </p>
    <ul class="space-y-1.5" role="list">
      {
        [
          { dia: "Lunes — Viernes", hora: "8:00 — 17:00" },
          { dia: "Sábado", hora: "9:00 — 13:00" },
          { dia: "Domingo", hora: "Cerrado" },
        ].map((h) => (
          <li class="flex items-center justify-between">
            <span
              class="text-xs text-[var(--color-steel-500)]"
              style="font-family: var(--font-body);"
            >
              {h.dia}
            </span>
            <span
              class="text-xs font-semibold text-[var(--color-carbon-900)]"
              style="font-family: var(--font-body);"
            >
              {h.hora}
            </span>
          </li>
        ))
      }
    </ul>
    <p
      class="text-[10px] text-[var(--color-steel-400)] mt-3 border-t border-[var(--color-steel-100)] pt-3"
      style="font-family: var(--font-body);"
    >
      Zona horaria: Ciudad de México (UTC−6 / UTC−5 en verano)
    </p>
  </div>

  <!-- Servicios disponibles -->
  <div
    class="border border-[var(--color-steel-200)] rounded-xl overflow-hidden"
  >
    <div
      class="px-6 py-4 bg-[var(--color-steel-50)] border-b border-[var(--color-steel-100)]"
    >
      <p
        class="text-[10px] font-semibold tracking-widest uppercase text-[var(--color-steel-500)]"
        style="font-family: var(--font-body);"
      >
        Podemos ayudarte con
      </p>
    </div>
    <ul class="divide-y divide-[var(--color-steel-100)]" role="list">
      {
        serviciosLista.map((s: string) => (
          <li class="flex items-center gap-3 px-6 py-2.5">
            <span
              class="w-1.5 h-1.5 rounded-full bg-[var(--color-cofepris-700)] flex-shrink-0"
              aria-hidden="true"
            />
            <span
              class="text-xs text-[var(--color-steel-600)]"
              style="font-family: var(--font-body);"
            >
              {s}
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</div>
