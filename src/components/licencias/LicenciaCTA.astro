---
interface Props {
  titulo?: string;
  texto?: string;
}

const {
  titulo = '¿Necesitas tramitar esta licencia?',
  texto = 'Revisamos tu caso sin costo y te decimos qué trámite aplica, qué documentos faltan y cómo te acompañamos.',
} = Astro.props;
---

<section
  class="bg-carbon-900 rounded-xl p-8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6"
  aria-labelledby="cta-licencia-heading"
>
  <div>
    <h2
      id="cta-licencia-heading"
      class="text-lg font-bold text-white mb-1"
      style="font-family: var(--font-display);"
    >
      {titulo}
    </h2>
    <p class="text-sm text-steel-400 max-w-xl" style="font-family: var(--font-body);">
      {texto}
    </p>
  </div>
  <div class="flex flex-wrap gap-3 shrink-0">
    <a
      href="/contacto/"
      class="inline-flex items-center gap-2 bg-cofepris-700 hover:bg-cofepris-600 text-white font-semibold px-6 py-2.5 rounded text-sm transition-colors duration-150"
      style="font-family: var(--font-body);"
    >
      Solicitar consulta gratuita
    </a>
    <a
      href="https://wa.me/5215579113086?text=Hola%2C%20necesito%20información%20sobre%20trámites%20COFEPRIS"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-2 border border-carbon-700 text-steel-300 hover:text-white hover:border-steel-500 font-medium px-6 py-2.5 rounded text-sm transition-colors duration-150"
      style="font-family: var(--font-body);"
    >
      Escribir por WhatsApp
    </a>
  </div>
</section>
