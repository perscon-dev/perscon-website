---
/**
 * LicenciaHero.astro
 * Hero superior de cada página de licencia individual
 */

interface Props {
  nombre: string;
  description: string;
  textoCofepris: string;
  norma?: string;
  tiempo: string;
  slug: string;
  homoclave?: string;
}

const { nombre, description, textoCofepris, norma, tiempo, slug, homoclave } = Astro.props;
---

<section
  class="bg-carbon-950 border-b border-carbon-800"
>
  <div class="max-w-7xl mx-auto px-6 lg:px-8 py-14 lg:py-20">
    <!-- Breadcrumb visible -->
    <nav
      class="lh-fade-up lh-delay-1 flex items-center gap-2 text-xs text-steel-600 mb-8"
      aria-label="Ruta de navegación"
    >
      <a
        href="/"
        class="hover:text-white transition-colors duration-150"
        style="font-family: var(--font-body);"
      >
        Inicio
      </a>
      <span aria-hidden="true">/</span>
      <a
        href="/licencias-cofepris/"
        class="hover:text-white transition-colors duration-150"
        style="font-family: var(--font-body);"
      >
        Licencias COFEPRIS
      </a>
      <span aria-hidden="true">/</span>
      <span
        class="text-steel-400"
        style="font-family: var(--font-body);"
        aria-current="page"
      >
        {nombre}
      </span>
    </nav>

    <div class="grid lg:grid-cols-[1fr_300px] gap-10 items-center">
      <!-- Copy -->
      <div class="hero-content delay-1">
        {
          homoclave && (
            <p
              class="lh-fade-up lh-delay-2 text-[10px] font-mono font-semibold tracking-wider text-cofepris-400 mb-3"
              style="font-family: var(--font-body);"
            >
              Homoclave {homoclave}
            </p>
          )
        }
        {
          norma && (
            <p
              class="lh-fade-up lh-delay-2 text-[10px] font-semibold tracking-[0.18em] uppercase text-cofepris-500 mb-4 flex items-center gap-2"
              style="font-family: var(--font-body);"
            >
              <span
                class="w-6 h-px bg-cofepris-700 inline-block"
                aria-hidden="true"
              />
              {norma}
            </p>
          )
        }

        <h1
          class="lh-fade-up lh-delay-3 text-3xl lg:text-4xl font-bold text-white tracking-tight leading-tight mb-5 max-w-2xl"
          style="font-family: var(--font-display);"
        >
          {nombre}
        </h1>

        <p
          class="lh-fade-up lh-delay-4 text-steel-400 text-base leading-relaxed max-w-4xl mb-4"
          style="font-family: var(--font-body);"
        >
          {textoCofepris}
        </p>

        <p
          class="lh-fade-up lh-delay-4 text-steel-400 text-base leading-relaxed max-w-xl mb-4"
          style="font-family: var(--font-body);"
        >
          {description}
        </p>

        <span
          class="lh-fade-up lh-delay-5 inline-flex items-center gap-2 text-sm text-steel-300 border border-carbon-700 bg-carbon-800 px-3.5 py-1.5 rounded"
          style="font-family: var(--font-body);"
        >
          <svg
            class="w-3.5 h-3.5 text-cofepris-600"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          {tiempo}
        </span>
      </div>

      <!-- CTA card dark -->
      <div
        class="lh-fade-up lh-delay-4 border border-carbon-700 rounded-lg overflow-hidden"
      >
        <div
          class="px-5 py-4 bg-carbon-800 border-b border-carbon-700"
        >
          <p
            class="text-[10px] font-semibold tracking-widest uppercase text-steel-500"
            style="font-family: var(--font-body);"
          >
            ¿Necesitas esta licencia?
          </p>
        </div>
        <div class="p-5 space-y-3 bg-carbon-900">
          <a
            href="/contacto/"
            class="flex items-center justify-center gap-2 w-full bg-cofepris-700 hover:bg-cofepris-600 text-white font-semibold px-4 py-2.5 rounded text-sm transition-colors duration-150"
            style="font-family: var(--font-body);"
          >
            Solicitar Asesoría Gratuita
          </a>
          <a
            href="https://wa.me/5215579113086?text=Hola%2C%20necesito%20información%20sobre%20trámites%20COFEPRIS"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-center gap-2 w-full border border-carbon-700 hover:border-steel-500 text-steel-300 hover:text-white font-medium px-4 py-2.5 rounded text-sm transition-colors duration-150"
            style="font-family: var(--font-body);"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.124.558 4.121 1.534 5.856L.057 23.57a.75.75 0 00.914.914l5.714-1.477A11.942 11.942 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.75a9.713 9.713 0 01-4.964-1.363l-.356-.213-3.694.954.974-3.583-.232-.368A9.75 9.75 0 1112 21.75z"/>
            </svg>
            WhatsApp
          </a>
         
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes lhFadeUp {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .lh-fade-up {
    opacity: 0;
    animation: lhFadeUp 0.65s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  .lh-delay-1 {
    animation-delay: 0.05s;
  }
  .lh-delay-2 {
    animation-delay: 0.15s;
  }
  .lh-delay-3 {
    animation-delay: 0.28s;
  }
  .lh-delay-4 {
    animation-delay: 0.42s;
  }
  .lh-delay-5 {
    animation-delay: 0.55s;
  }
</style>
