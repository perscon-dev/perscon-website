---
/**
 * LicenciaAplica.astro
 * Grid de etiquetas "¿A quién aplica esta licencia?"
 */

interface Props {
  aplica: string[];
}

const { aplica } = Astro.props;
---

<section aria-labelledby="aplica-heading">
  <h2
    id="aplica-heading"
    class="text-xl font-bold text-[var(--color-carbon-900)] mb-5 pb-3 border-b border-[var(--color-steel-100)]"
    style="font-family: var(--font-display);"
  >
    ¿A quién aplica esta licencia?
  </h2>

  <ul class="grid sm:grid-cols-2 gap-2" role="list">
    {aplica.map((item: string) => (
      <li
        class="flex items-center gap-2.5 text-sm text-[var(--color-steel-700)] bg-[var(--color-steel-50)] border border-[var(--color-steel-100)] px-4 py-2.5 rounded"
        style="font-family: var(--font-body);"
      >
        <svg
          class="w-3.5 h-3.5 text-[var(--color-cofepris-700)] flex-shrink-0"
          fill="none" stroke="currentColor" viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
        </svg>
        {item}
      </li>
    ))}
  </ul>
</section>