---
const stats = [
  { valor: "+50", label: "Licencias gestionadas" },
  { valor: "100%", label: "Tasa de aprobación" },
  { valor: "-45%", label: "Reducción en tiempos" },
  { valor: "+5", label: "Años de experiencia" },
];
---

<!-- Barra de estadísticas -->
<div class="relative ">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <dl class="grid grid-cols-2 lg:grid-cols-4">
      {stats.map((s) => (
        <div class="py-6 px-4 text-center">
          <dt
            class="text-2xl lg:text-3xl font-bold text-carbon-900"
            style="font-family: var(--font-display);"
          >
            {s.valor}
          </dt>
          <dd
            class="text-gray-600 text-xs uppercase tracking-widest mt-1"
            style="font-family: var(--font-body);"
          >
            {s.label}
          </dd>
        </div>
      ))}
    </dl>
  </div>
</div>