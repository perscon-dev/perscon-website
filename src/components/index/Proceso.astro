---

const pasos = [
  {
    num: '01',
    title: 'Consulta Inicial Gratuita',
    descripcion:
      'Nos compartes los detalles de tu establecimiento: tipo de servicios, ubicación, estado actual. Identificamos el trámite correcto y te explicamos exactamente qué necesitas.',
    duracion: 'Mismo día',
    icono: 'chat',
  },
  {
    num: '02',
    title: 'Revisión y Preparación del Expediente',
    descripcion:
      'Preparamos y revisamos toda la documentación requerida por COFEPRIS: planos, manuales de procedimientos, constancias del personal, comprobantes de equipos y más. Sin documentos faltantes.',
    duracion: '1–2 semanas',
    icono: 'document',
  },
  {
    num: '03',
    title: 'Presentación ante COFEPRIS',
    descripcion:
      'Presentamos el expediente completo ante la autoridad sanitaria. Gestionamos el ingreso, el pago de derechos y el número de folio oficial para rastreo del trámite.',
    duracion: 'Día de presentación',
    icono: 'submit',
  },
  {
    num: '04',
    title: 'Seguimiento y Atención de Requerimientos',
    descripcion:
      'Damos seguimiento activo al estatus del expediente. Si COFEPRIS emite requerimientos adicionales, los atendemos de forma inmediata para no perder tiempo en el proceso.',
    duracion: 'Durante todo el trámite',
    icono: 'track',
  },
  {
    num: '05',
    title: 'Obtención de la Licencia',
    descripcion:
      'Una vez aprobado, te entregamos la licencia sanitaria oficial y te asesoramos sobre obligaciones posteriores: renovaciones, actualizaciones y cambios de condiciones.',
    duracion: 'Al cierre del trámite',
    icono: 'check',
  },
];

const iconPaths: Record<string, string> = {
  chat:     'M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z',
  document: 'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z',
  submit:   'M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12',
  track:    'M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4',
  check:    'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
};
---

<section
  class="bg-carbon-950 border-t border-carbon-800"
  aria-labelledby="proceso-heading"
>
  <div class="max-w-7xl mx-auto px-6 lg:px-8 py-20 lg:py-24">

    <!-- Encabezado -->
    <div class="max-w-xl mb-16">
      <p
        class="text-[10px] font-semibold tracking-[0.2em] uppercase text-cofepris-500 mb-3 flex items-center gap-2"
        style="font-family: var(--font-body);"
      >
        <span class="w-6 h-px bg-cofepris-700 inline-block" aria-hidden="true"></span>
        Cómo Funciona
      </p>
      <h2
        id="proceso-heading"
        class="text-3xl lg:text-4xl font-bold text-white tracking-tight leading-tight mb-4"
        style="font-family: var(--font-display);"
      >
        Proceso Claro,<br />Sin Sorpresas
      </h2>
      <p
        class="text-steel-400 text-base leading-relaxed"
        style="font-family: var(--font-body);"
      >
        Nos encargamos de todo. Tu responsabilidad es operar tu establecimiento,
        la nuestra es obtener la licencia.
      </p>
    </div>

    <!-- Pasos -->
    <ol class="relative space-y-0 divide-y divide-carbon-800" role="list">
      <!-- Línea conectora vertical (desktop) -->
      <div
        class="absolute left-4.75 top-0 bottom-0 w-px bg-linear-to-b from-cofepris-700 via-carbon-700 to-transparent hidden lg:block"
        aria-hidden="true"
      ></div>

        {pasos.map((paso, idx) => (
          <li class="lg:grid lg:grid-cols-[40px_1fr_200px] lg:gap-10 py-8 items-start group">
            <div class="flex items-center gap-4 mb-4 lg:mb-0 lg:flex-col lg:gap-0">
              <div
                class="relative z-10 w-10 h-10 rounded-full border-2 border-carbon-700 bg-carbon-900 group-hover:border-cofepris-700 flex items-center justify-center transition-colors duration-200 shrink-0"
                aria-hidden="true"
              >
                <svg class="w-4 h-4 text-cofepris-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={iconPaths[paso.icono]} />
                </svg>
              </div>
            </div>
            <div>
              <div class="flex items-center gap-3 mb-2">
                <span
                  class="text-[12px] font-bold tracking-widest text-white"
                  style="font-family: var(--font-display);"
                  aria-hidden="true"
                >
                  PASO {paso.num}
                </span>
              </div>
              <h3
                class="text-base font-bold text-white mb-2 group-hover:text-cofepris-400 transition-colors duration-150"
                style="font-family: var(--font-display);"
              >
                {paso.title}
              </h3>
              <p
                class="text-md text-steel-300 leading-relaxed max-w-lg"
                style="font-family: var(--font-body);"
              >
                {paso.descripcion}
              </p>
            </div>

            <div class="mt-4 lg:mt-0 lg:text-right">
              <span
                class="inline-block text-[15px] font-semibold tracking-wide text-white bg-carbon-900 px-3 py-1 rounded"
                style="font-family: var(--font-body);"
              >
                {paso.duracion}
              </span>
            </div>
          </li>
        ))}
    </ol>

    <!-- CTA inline -->
    <div class="mt-12 pt-10 border-t border-carbon-800 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-5">
      <p
        class="text-steel-400 text-sm max-w-md"
        style="font-family: var(--font-body);"
      >
        El tiempo total depende del tipo de licencia y la complejidad del
        establecimiento. En la consulta inicial te damos un estimado concreto.
      </p>
      <a
        href="/contacto/"
        class="shrink-0 inline-flex items-center gap-2 bg-cofepris-700 hover:bg-cofepris-600 text-white font-semibold px-6 py-2.5 rounded text-sm transition-colors duration-150"
        style="font-family: var(--font-body);"
      >
        Iniciar consulta gratuita
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
        </svg>
      </a>
    </div>

  </div>
</section>