    descripcion:
      "Autorización para establecimientos que realizan extracción, procesamiento, almacenamiento y transfusión de sangre o sus componentes. Normativa NOM-253-SSA1-2012.",
    aplica: [
      "Bancos de sangre",
      "Servicios de transfusión",
      "Hospitales con banco propio",
    ],
    tiempo: "45 días hábiles",
  },
  {
    num: "05",
    title: "Licencia para Servicios de Transfusión Hospitalaria",
    slug: "licencia-transfusion-hospitalaria",
    descripcion:
      "Autorización sanitaria para hospitales y establecimientos de salud que realizan recepción, conservación, compatibilidad y administración de componentes sanguíneos conforme a la NOM-253-SSA1-2012.",
    aplica: [
      "Hospitales públicos",
      "Hospitales privados",
      "Clínicas con servicio de transfusión",
    ],
    tiempo: "45 días hábiles",
  },
  {
    num: "06",
    title: "Licencia de Hemodiálisis",
    slug: "licencia-hemodialisis",
    descripcion:
      "Licencia sanitaria para unidades y centros que brindan servicios de hemodiálisis y diálisis peritoneal. Cumplimiento de la NOM-003-SSA3-2010 y estándares de infraestructura.",
    aplica: [
