---
const servicios = [
  {
    num: "01",
    title: "Permiso Sanitario de Construcción",
    slug: "permiso-construccion",
    descripcion:
      "Requisito obligatorio para construir, ampliar o remodelar cualquier establecimiento médico en México. Incluye revisión de planos, cumplimiento de NOM y acompañamiento ante COFEPRIS.",
    aplica: ["Hospitales", "Clínicas", "Laboratorios"],
    tiempo: "60 días hábiles",
  },
  {
    num: "02",
    title: "Licencia para Establecimientos con Actos Quirúrgicos",
    slug: "licencia-actos-quirurgicos",
    descripcion:
      "Autorización sanitaria para clínicas y hospitales que realizan procedimientos quirúrgicos u obstétricos. Cumplimiento de la NOM-016-SSA3-2012 y demás normativa aplicable.",
    aplica: ["Quirófanos", "Hospitales", "Clínicas de cirugía", "Maternidades"],
    tiempo: "60 días hábiles",
  },
  {
    num: "03",
    title: "Licencia para Fuentes de Radiación Médica",
    slug: "licencia-radiacion",
    descripcion:
      "Licencia sanitaria para establecimientos que operan equipos de rayos X, tomografía, fluoroscopía y otros equipos de diagnóstico por imagen. Cumplimiento de la NOM-229-SSA1-2002.",
    aplica: ["Rayos X", "Tomografía", "Fluoroscopía", "Densitometría"],
    tiempo: "60 días hábiles",
  },
  {
    num: "04",
    title: "Licencia para Bancos de Sangre y Transfusión",
