---
import { getCollection } from 'astro:content';

const articulos = (await getCollection('articulos', ({ data }) => !data.borrador)).slice(0, 3);
---

{
  articulos.length > 0 && (
    <section class="bg-white border-t border-steel-100" aria-labelledby="articulos-heading">
      <div class="max-w-7xl mx-auto px-6 lg:px-8 py-16 lg:py-20">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8">
          <div>
            <p
              class="text-[10px] font-semibold tracking-[0.2em] uppercase text-cofepris-700 mb-3 flex items-center gap-2"
              style="font-family: var(--font-body);"
            >
              <span class="w-6 h-px bg-cofepris-700 inline-block" aria-hidden="true" />
              Recursos
            </p>
            <h2
              id="articulos-heading"
              class="text-2xl lg:text-3xl font-bold text-carbon-900 tracking-tight"
              style="font-family: var(--font-display);"
            >
              Guías para tus trámites COFEPRIS
            </h2>
          </div>
          <a
            href="/recursos/"
            class="text-sm font-semibold text-cofepris-700 hover:underline"
            style="font-family: var(--font-body);"
          >
            Ver todos los recursos →
          </a>
        </div>
        <ul class="grid md:grid-cols-3 gap-4" role="list">
          {articulos.map((a) => (
            <li>
              <a
                href={`/recursos/${a.slug}/`}
                class="block h-full border border-steel-200 rounded-xl p-6 bg-white hover:border-cofepris-300 transition-colors"
              >
                <h3 class="text-base font-bold text-carbon-900 mb-2" style="font-family: var(--font-display);">
                  {a.data.title}
                </h3>
                <p class="text-sm text-steel-600 leading-relaxed" style="font-family: var(--font-body);">
                  {a.data.description}
                </p>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}
