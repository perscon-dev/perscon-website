              },
            ].map((r) => (
              <a
                href={r.href}
                target="_blank"
                rel="noopener noreferrer"
                class="w-8 h-8 rounded bg-carbon-800 border border-carbon-700 flex items-center justify-center hover:border-cofepris-700 hover:bg-cofepris-900 transition-colors duration-150"
                aria-label={r.label}
              >
                <svg
                  class="w-3.5 h-3.5 text-steel-300"
                  fill="currentColor"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path d={r.path} />
                </svg>
              </a>
            ))
          }
        </div>
      </div>

      <!-- Columna 2: Licencias COFEPRIS -->
      <div>
        <h2
          class="text-[10px] font-semibold tracking-[0.18em] uppercase text-steel-300 mb-4 flex items-center gap-2"
          style="font-family: var(--font-body);"
        >
          <span class="w-3 h-px bg-cofepris-700 inline-block"></span>
          Licencias COFEPRIS
        </h2>
        <ul class="space-y-2.5" role="list">
          {
            licencias.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-steel-400 hover:text-white text-sm transition-colors duration-150 flex items-start gap-2 group"
                  style="font-family: var(--font-body);"
                >
                  <svg
                    class="w-3 h-3 text-cofepris-700 shrink-0 mt-0.5 opacity-0 group-hover:opacity-100 transition-opacity duration-150"
                    fill="currentColor"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <path
                      d="M9 5l7 7-7 7"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      fill="none"
                    />
                  </svg>
                  <svg
                    class="w-3 h-3 text-(--color-carbon-600) shrink-0 mt-0.5 group-hover:opacity-0 group-hover:hidden transition-opacity duration-150"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M9 5l7 7-7 7"
                    />
                  </svg>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Columna 3: Empresa -->
      <div>
        <h2
          class="text-[10px] font-semibold tracking-[0.18em] uppercase text-steel-300 mb-4 flex items-center gap-2"
          style="font-family: var(--font-body);"
        >
          <span class="w-3 h-px bg-cofepris-700 inline-block"></span>
          Empresa
        </h2>
        <ul class="space-y-2.5" role="list">
          {
            empresa.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-steel-400 hover:text-white text-sm transition-colors duration-150"
                  style="font-family: var(--font-body);"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

<!-- Columna 4: Recursos -->
<div>
  <h2
    class="text-[10px] font-semibold tracking-[0.18em] uppercase text-steel-300 mb-4 flex items-center gap-2"
    style="font-family: var(--font-body);"
  >
    <span class="w-3 h-px bg-cofepris-700 inline-block"></span>
    Recursos
  </h2>
  <ul class="space-y-2.5 mb-6" role="list">
    {
      recursos.map((item) => (
        <li>
          <a
            href={item.href}
            class="text-steel-400 hover:text-white text-sm transition-colors duration-150"
            style="font-family: var(--font-body);"
          >
            {item.label}
          </a>
        </li>
      ))
    }
  </ul>
</div>

<!-- Columna 5: Cobertura Nacional -->
<div>
  <h2
    class="text-[10px] font-semibold tracking-[0.18em] uppercase text-steel-300 mb-4 flex items-center gap-2"
    style="font-family: var(--font-body);"
  >
    <span class="w-3 h-px bg-cofepris-700 inline-block"></span>
    Cobertura Nacional
  </h2>
  <ul class="space-y-2.5" role="list">
    {
      CIUDADES_SEO.map((ciudad) => (
        <li>
          <a
            href={`/licencias-cofepris/ciudad/${ciudad.slug}/`}
            class="text-steel-400 hover:text-white text-sm transition-colors duration-150"
            style="font-family: var(--font-body);"
          >
            {ciudad.name}
          </a>
        </li>
      ))
    }
  </ul>
</div>

      <!-- Columna 5: Legal -->
      <div>
        <h2
          class="text-[10px] font-semibold tracking-[0.18em] uppercase text-steel-300 mb-4 flex items-center gap-2"
          style="font-family: var(--font-body);"
        >
          <span class="w-3 h-px bg-cofepris-700 inline-block"></span>
          Legal
        </h2>
        <ul class="space-y-2.5" role="list">
          <li>
            <a
              href="/privacidad/"
              class="text-steel-400 hover:text-white text-sm transition-colors duration-150"
              style="font-family: var(--font-body);"
