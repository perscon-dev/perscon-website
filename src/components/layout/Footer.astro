---

<footer class="bg-carbon-900 text-steel-300" role="contentinfo">
  <!-- Banda CTA superior -->
  <div class="border-b border-carbon-700">
    <div class="max-w-7xl mx-auto px-6 lg:px-8 py-10">
      <div
        class="flex flex-col lg:flex-row items-start lg:items-center justify-between gap-6"
      >
        <div>
          <p
            class="text-white font-bold text-xl lg:text-2xl tracking-tight"
            style="font-family: var(--font-display);"
          >
            ¿Necesitas una Licencia Sanitaria COFEPRIS?
          </p>
          <p
            class="text-steel-300 mt-1 text-sm"
            style="font-family: var(--font-body);"
          >
            Asesoría personalizada · Reducción de tiempos · Gestión integral del
            trámite
          </p>
        </div>
        <div class="flex flex-col sm:flex-row gap-3 shrink-0">
          <a
            href="/contacto/"
            class="inline-flex items-center justify-center bg-cofepris-700 hover:bg-cofepris-600 text-white font-semibold px-6 py-2.5 rounded text-sm transition-colors duration-150"
            style="font-family: var(--font-body);"
          >
            Solicitar Asesoría Gratuita
          </a>
          <a
            href="https://wa.me/5215579113086"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 border border-carbon-600 text-steel-300 hover:text-white hover:border-steel-400 font-semibold px-6 py-2.5 rounded text-sm transition-colors duration-150"
            style="font-family: var(--font-body);"
          >
            <svg
              class="w-4 h-4"
              fill="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"
