                d="M12 0C5.373 0 0 5.373 0 12c0 2.124.558 4.121 1.534 5.856L.057 23.57a.75.75 0 00.914.914l5.714-1.477A11.942 11.942 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.75a9.713 9.713 0 01-4.964-1.363l-.356-.213-3.694.954.974-3.583-.232-.368A9.75 9.75 0 1112 21.75z"
              ></path>
            </svg>
            WhatsApp
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Cuerpo principal -->
  <div class="max-w-7xl mx-auto px-6 lg:px-8 py-14">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10">
      <!-- Columna 1: Marca -->
      <div class="lg:col-span-1">
        <a
          href="/"
          class="flex items-center gap-3 mb-5 w-fit"
          aria-label="Perscon, ir al inicio"
        >
          <img
            src="/images/Logo/Logo.webp"
            alt="Perscon logo"
            class="h-22 w-auto"
            width="36"
            height="36"
            loading="lazy"
          />
          <div class="leading-none">
            <span
              class="block text-[14px] font-bold tracking-[0.2em] uppercase text-white"
              style="font-family: var(--font-display);"
            >
              PERSCON
            </span>
            <span
              class="block text-[9px] tracking-[0.12em] uppercase text-cofepris-400 mt-0.5"
              style="font-family: var(--font-body);"
            >
              Asesoría COFEPRIS
            </span>
          </div>
        </a>

        <p
          class="text-steel-300 text-sm leading-relaxed mb-6"
          style="font-family: var(--font-body);"
        >
          Especialistas en asesoría regulatoria y gestión integral de trámites
          ante COFEPRIS para establecimientos médicos en México.
        </p>

        <!-- NAP -->
        <address
          class="not-italic space-y-2 text-sm"
          style="font-family: var(--font-body);"
        >
          <div class="flex items-start gap-2">
            <svg
              class="w-3.5 h-3.5 text-cofepris-600 shrink-0 mt-0.5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
              ></path><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
            <span class="text-steel-400">Estado de México, México</span>
          </div>
          <div class="flex items-center gap-2">
            <svg
              class="w-3.5 h-3.5 text-cofepris-600 shrink-0"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
              ></path>
            </svg>
            <a
              href="mailto:contacto@perscon.com.mx"
              class="text-steel-400 hover:text-white transition-colors duration-150"
            >
              contacto@perscon.com.mx
            </a>
          </div>
          <div class="flex items-center gap-2">
            <svg
              class="w-3.5 h-3.5 text-cofepris-600 shrink-0"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 5a2 2 0 012-2h2.28a2 2 0 011.9 1.37l1.1 3.3a2 2 0 01-.45 2.11l-1.27 1.27a16 16 0 006.36 6.36l1.27-1.27a2 2 0 012.11-.45l3.3 1.1A2 2 0 0119.72 19H22a2 2 0 012 2v1a1 1 0 01-1 1h-1C10.3 23 1 13.7 1 2V1a1 1 0 011-1h1a2 2 0 012 2v2.28a2 2 0 01-1.37 1.9l-3.3 1.1a2 2 0 01-2.11-.45L3 5z"
              ></path>
            </svg>
            <a
