              },
              {
                label: "WhatsApp Perscon",
                href: "https://wa.me/5215579113086?text=Hola%2C%20necesito%20información%20sobre%20trámites%20COFEPRIS",
                path: "M20.52 3.48A11.92 11.92 0 0012.05 0C5.5 0 .16 5.34.16 11.91c0 2.1.55 4.05 1.52 5.77L0 24l6.48-1.7a11.9 11.9 0 005.57 1.41h.01c6.55 0 11.89-5.34 11.89-11.91 0-3.18-1.24-6.17-3.43-8.32zM12.06 21.3h-.01a9.36 9.36 0 01-4.77-1.3l-.34-.2-3.85 1.01 1.03-3.76-.22-.35a9.33 9.33 0 01-1.43-5c0-5.16 4.2-9.36 9.37-9.36 2.5 0 4.85.97 6.61 2.72a9.28 9.28 0 012.74 6.62c0 5.16-4.2 9.36-9.37 9.36zm5.13-6.97c-.28-.14-1.65-.81-1.9-.9-.26-.1-.45-.14-.64.14-.19.28-.73.9-.9 1.08-.17.19-.33.21-.61.07-.28-.14-1.18-.43-2.25-1.36-.83-.74-1.4-1.66-1.56-1.94-.16-.28-.02-.43.12-.57.13-.13.28-.33.42-.5.14-.17.19-.28.28-.47.09-.19.05-.36-.02-.5-.07-.14-.64-1.54-.88-2.11-.23-.55-.47-.48-.64-.49l-.55-.01c-.19 0-.5.07-.76.35-.26.28-1 1-1 2.44 0 1.44 1.03 2.83 1.18 3.03.14.19 2.03 3.1 4.92 4.34.69.3 1.23.48 1.65.61.69.22 1.32.19 1.82.11.56-.08 1.65-.67 1.88-1.32.23-.65.23-1.2.16-1.32-.07-.12-.25-.19-.53-.33z",
              },
              {
                label: "Instagram Perscon",
                href: "https://www.instagram.com/perscon.mx?fbclid=IwZXh0bgNhZW0CMTAAYnJpZBExdzN5Sm9hQnV3MWZiRmUybHNydGMGYXBwX2lkEDIyMjAzOTE3ODgyMDA4OTIAAR7yctoBmSu_maHkjW3VLFpx_yzJEtRclBygR6Te8qaGXA1vuws5yrG_9rHVCg_aem_S28W0JBxJmTDNjxidcRCfw",
                path: "M7.75 2C4.57 2 2 4.57 2 7.75v8.5C2 18.43 4.57 21 7.75 21h8.5C18.43 21 21 18.43 21 15.25v-8.5C21 4.57 18.43 2 15.25 2h-8.5zm0 2h8.5A3.25 3.25 0 0119.5 7.25v8.5A3.25 3.25 0 0116.25 19h-8.5A3.25 3.25 0 014.5 15.75v-8.5A3.25 3.25 0 017.75 4zm8.75 1a1.25 1.25 0 100 2.5 1.25 1.25 0 000-2.5zM12 7a5 5 0 100 10 5 5 0 000-10zm0 2a3 3 0 110 6 3 3 0 010-6z",
