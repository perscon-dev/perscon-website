---
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import { CIUDADES_SEO, LICENCIAS_SEO } from "../../../data/licenciasSeo";

const SITE_URL = "https://www.perscon.com.mx";

export async function getStaticPaths() {
  return CIUDADES_SEO.map((ciudad) => ({
    params: { ciudad: ciudad.slug },
    props: { ciudad },
  }));
}

interface Props {
  ciudad: (typeof CIUDADES_SEO)[number];
}

const { ciudad } = Astro.props;

const licencias: CollectionEntry<"licencias">[] =
  await getCollection("licencias");
const ordenadas = [...licencias].sort((a, b) => a.data.orden - b.data.orden);

const pageUrl = `${SITE_URL}/licencias-cofepris/ciudad/${ciudad.slug}/`;
const title = `Licencia Sanitaria COFEPRIS en ${ciudad.name} | Perscon`;
const description = `Gestión de licencias sanitarias COFEPRIS en ${ciudad.name}, ${ciudad.state}: permiso de construcción, actos quirúrgicos, radiación, bancos de sangre y hemodiálisis. Asesoría especializada en la delegación local. Consulta gratuita.`;

const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "@id": `${pageUrl}#itemlist`,
  name: `Licencias COFEPRIS en ${ciudad.name}`,
  numberOfItems: ordenadas.length,
  itemListElement: ordenadas.map((lic, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: getLicenciaSeo(lic.slug)?.h1 ?? lic.data.nombre,
    item: `${SITE_URL}/licencias-cofepris/${lic.slug}/`,
  })),
};

function getLicenciaSeo(slug: string) {
  return LICENCIAS_SEO[slug];
}

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": `${pageUrl}#service`,
  name: `Asesoría COFEPRIS en ${ciudad.name}`,
  description,
  url: pageUrl,
  provider: { "@id": `${SITE_URL}/#organization` },
  areaServed: {
    "@type": "City",
    name: ciudad.name,
    containedInPlace: { "@type": "State", name: ciudad.state },
  },
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: `¿COFEPRIS federal tramita licencias en ${ciudad.name}?`,
      acceptedAnswer: {
        "@type": "Answer",
        text: `Sí. Las licencias sanitarias para establecimientos médicos en ${ciudad.name} se gestionan ante COFEPRIS federal. Los requisitos y homoclaves son los mismos que en el resto del país; la diferencia está en la documentación del inmueble y el cumplimiento de NOM aplicables.`,
      },
    },
    {
      "@type": "Question",
      name: `¿Cuánto tarda una licencia COFEPRIS en ${ciudad.name}?`,
      acceptedAnswer: {
        "@type": "Answer",
        text: "Entre 45 y 90 días hábiles según el tipo de licencia, contados desde la presentación de un expediente completo. La documentación incompleta es la principal causa de retrasos en cualquier estado.",
      },
    },
  ],
};
---

<Layout
  title={title}
  description={description}
  canonical={`/licencias-cofepris/ciudad/${ciudad.slug}/`}
  pageSchema={[itemListSchema, serviceSchema, faqSchema]}
  breadcrumbs={[
    { name: "Licencias COFEPRIS", url: "/licencias-cofepris/" },
    { name: ciudad.name, url: `/licencias-cofepris/ciudad/${ciudad.slug}/` },
  ]}
>
  <section class="bg-carbon-950 border-b border-carbon-800">
    <div class="max-w-7xl mx-auto px-6 lg:px-8 py-14 lg:py-20">
      <!-- Breadcrumb visible -->
      <nav
        class="lh-fade-up lh-delay-1 flex items-center gap-2 text-xs text-steel-600 mb-8"
        aria-label="Ruta de navegación"
      >
        <a
          href="/"
          class="hover:text-white transition-colors duration-150"
          style="font-family: var(--font-body);"
        >
          Inicio
        </a>
        <span aria-hidden="true">/</span>
        <a
          href="/licencias-cofepris/"
          class="hover:text-white transition-colors duration-150"
          style="font-family: var(--font-body);"
        >
          Licencias COFEPRIS
        </a>
        <span aria-hidden="true">/</span>
        <span
          class="text-steel-400"
          style="font-family: var(--font-body);"
          aria-current="page"
        >
          {ciudad.name}
        </span>
      </nav>

      <div class="grid lg:grid-cols-[1fr_300px] gap-10 items-center">
        <!-- Copy -->
        <div class="hero-content delay-1">
          <ul class="flex flex-row gap-4 mb-3">
            {
              ordenadas.map((lic) => {
                const seo = getLicenciaSeo(lic.slug);
                return (
                  <li class="">
                    <p
                      class="lh-fade-up lh-delay-2 text-[10px] font-mono font-semibold tracking-wider text-cofepris-400"
                      style="font-family: var(--font-body);"
                    >
                      {seo?.homoclave}
                    </p>
                  </li>
                );
              })
            }
          </ul>

          <h1
            class="lh-fade-up lh-delay-3 text-3xl lg:text-4xl font-bold text-white tracking-tight leading-tight mb-5 max-w-2xl"
            style="font-family: var(--font-display);"
          >
            Licencias Sanitarias COFEPRIS en {ciudad.name}
          </h1>

          <p
            class="lh-fade-up lh-delay-4 text-steel-400 text-base leading-relaxed max-w-4xl mb-4"
            style="font-family: var(--font-body);"
          >
            {ciudad.intro}
          </p>

          <p
            class="text-steel-400 text-sm leading-relaxed max-w-3xl"
            style="font-family: var(--font-body);"
          >
            Perscon gestiona el expediente completo ante COFEPRIS: diagnóstico
            previo, preparación documental, presentación, seguimiento y atención
            de requerimientos. Cobertura en {ciudad.state} y toda la República Mexicana.
          </p>
        </div>

        <!-- CTA card dark -->
        <div
          class="lh-fade-up lh-delay-4 border border-carbon-700 rounded-lg overflow-hidden"
        >
          <div class="px-5 py-4 bg-carbon-800 border-b border-carbon-700">
            <p
              class="text-[10px] font-semibold tracking-widest uppercase text-steel-500"
              style="font-family: var(--font-body);"
            >
              ¿Necesitas esta licencia?
            </p>
          </div>
          <div class="p-5 space-y-3 bg-carbon-900">
            <a
              href="/contacto/"
              class="flex items-center justify-center gap-2 w-full bg-cofepris-700 hover:bg-cofepris-600 text-white font-semibold px-4 py-2.5 rounded text-sm transition-colors duration-150"
              style="font-family: var(--font-body);"
            >
              Solicitar Asesoría Gratuita
            </a>
            <a
              href="https://wa.me/5215579113086?text=Hola%2C%20necesito%20información%20sobre%20trámites%20COFEPRIS"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-center gap-2 w-full border border-carbon-700 hover:border-steel-500 text-steel-300 hover:text-white font-medium px-4 py-2.5 rounded text-sm transition-colors duration-150"
              style="font-family: var(--font-body);"
            >
              <svg
                class="w-4 h-4"
                fill="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"
                ></path><path
                  d="M12 0C5.373 0 0 5.373 0 12c0 2.124.558 4.121 1.534 5.856L.057 23.57a.75.75 0 00.914.914l5.714-1.477A11.942 11.942 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.75a9.713 9.713 0 01-4.964-1.363l-.356-.213-3.694.954.974-3.583-.232-.368A9.75 9.75 0 1112 21.75z"
                ></path>
              </svg>
              WhatsApp
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
  <!--  -->
  <div class="max-w-7xl mx-auto px-6 lg:px-8 py-14 lg:py-20">
    <h2
      class="text-2xl font-bold text-carbon-900 mb-2"
      style="font-family: var(--font-display);"
    >
      Trámites COFEPRIS que gestionamos en {ciudad.name}
    </h2>
    <p
      class="text-steel-600 text-sm mb-8 max-w-2xl"
      style="font-family: var(--font-body);"
    >
      Cada enlace lleva a la guía nacional con requisitos, homoclave, tiempos y
      preguntas frecuentes del trámite.
    </p>

    <ul class="grid md:grid-cols-2 gap-4" role="list">
      {
        ordenadas.map((lic) => {
          const seo = getLicenciaSeo(lic.slug);
          return (
            <li>
              <article class="h-full border border-steel-200 rounded-xl p-6 bg-white hover:border-cofepris-300 transition-colors">
                <p class="text-[10px] font-mono text-steel-500 mb-2">
                  {seo?.homoclave}
                </p>
                <h3
                  class="text-lg font-bold text-carbon-900 mb-2"
                  style="font-family: var(--font-display);"
                >
                  <a
                    href={`/licencias-cofepris/${lic.slug}/`}
                    class="hover:text-cofepris-700 transition-colors"
                  >
                    {seo?.h1 ?? lic.data.nombre}
                  </a>
                </h3>
                <p
                  class="text-sm text-steel-600 leading-relaxed mb-4"
                  style="font-family: var(--font-body);"
                >
                  {lic.data.description}
                </p>
                <div class="flex flex-wrap gap-3 text-xs">
                  <a
                    href={`/licencias-cofepris/${lic.slug}/`}
                    class="font-semibold text-cofepris-700 hover:underline"
                    style="font-family: var(--font-body);"
                  >
                    Ver guía completa →
                  </a>
                  <a
                    href={`/requisitos/#${lic.slug}`}
                    class="text-steel-500 hover:text-cofepris-700"
                    style="font-family: var(--font-body);"
                  >
                    Requisitos
                  </a>
                </div>
              </article>
            </li>
          );
        })
      }
    </ul>

    <div
      class="mt-12 p-8 bg-cofepris-50 border border-cofepris-100 rounded-xl flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6"
    >
      <div>
        <h2
          class="text-xl font-bold text-carbon-900"
          style="font-family: var(--font-display);"
        >
          ¿Tu establecimiento está en {ciudad.name}?
        </h2>
        <p
          class="text-sm text-steel-600 mt-1"
          style="font-family: var(--font-body);"
        >
          Consulta gratuita en 24 horas. Identificamos el trámite correcto y el
          estado de tu expediente ante la delegación de COFEPRIS en {
            ciudad.state
          }.
        </p>
      </div>
      <a
        href="/contacto/"
        class="shrink-0 bg-cofepris-700 hover:bg-cofepris-600 text-white font-semibold px-6 py-3 rounded text-sm transition-colors"
        style="font-family: var(--font-body);"
      >
        Solicitar asesoría en {ciudad.name}
      </a>
    </div>

    <div class="mt-10">
      <p
        class="text-xs font-semibold tracking-widest uppercase text-steel-400 mb-3"
        style="font-family: var(--font-body);"
      >
        Otras ciudades
      </p>
      <ul class="flex flex-wrap gap-2" role="list">
        {
          CIUDADES_SEO.filter((c) => c.slug !== ciudad.slug).map((c) => (
            <li>
              <a
                href={`/licencias-cofepris/ciudad/${c.slug}/`}
                class="text-sm text-cofepris-700 border border-steel-200 px-3 py-1 rounded hover:bg-cofepris-50"
                style="font-family: var(--font-body);"
              >
                {c.name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</Layout>
