---
/**
 * src/pages/nosotros/index.astro
 * Ruta: /nosotros/
 */

import Layout            from '../../layouts/Layout.astro';
import NosotrosHero      from '../../components/nosotros/NosotrosHero.astro';
import NosotrosMision    from '../../components/nosotros/NosotrosMision.astro';
import NosotrosValores   from '../../components/nosotros/NosotrosValores.astro';
import NosotrosCobertura from '../../components/nosotros/NosotrosCobertura.astro';

const SITE_URL = 'https://www.perscon.com.mx';

const aboutPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  '@id': `${SITE_URL}/nosotros/#aboutpage`,
  name: 'Nosotros — Perscon, Especialistas en Asesoría COFEPRIS',
  description: 'Conoce a Perscon: firma especializada en asesoría regulatoria sanitaria para establecimientos médicos en México.',
  url: `${SITE_URL}/nosotros/`,
  inLanguage: 'es-MX',

  isPartOf: { '@id': `${SITE_URL}/#website` },

  about: {
    '@type': 'Organization',
    '@id': `${SITE_URL}/#organization`,
    name: 'Perscon'
  },

  publisher: {
    '@id': `${SITE_URL}/#organization`
  },

  mainEntity: {
    '@id': `${SITE_URL}/#organization`,
  },
};
---

<Layout
  title="Nosotros — Especialistas en Asesoría COFEPRIS"
  description="Somos Perscon, firma especializada en gestoría regulatoria sanitaria para establecimientos médicos en México. +150 licencias COFEPRIS obtenidas. 0 rechazadas."
  canonical="/nosotros/"
  pageSchema={aboutPageSchema}
  breadcrumbs={[{ name: 'Nosotros', url: '/nosotros/' }]}
>
  <NosotrosHero />
  <NosotrosMision />
  <NosotrosValores />

</Layout>