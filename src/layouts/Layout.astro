---
import Header from "../components/layout/Navbar.astro";
import Footer from "../components/layout/Footer.astro";
import CookieBanner from "../components/layout/CookieBanner.astro";
import "../styles/global.css";
import WhatsAppFloat from "../components/layout/WhatsAppFloat.astro";
import { CIUDADES_SEO } from "../data/licenciasSeo.ts";

interface BreadcrumbItem {
  name: string;
  url: string;
}

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogType?: "website" | "article" | "profile";
  noindex?: boolean;
  nofollow?: boolean;
  breadcrumbs?: BreadcrumbItem[];
  pageSchema?: Record<string, unknown> | Record<string, unknown>[];
  ogLocale?: string;
  articleAuthor?: string;
  articlePublishedTime?: string;
  articleModifiedTime?: string;
  articleSection?: string;
  bodyClass?: string;
  ogTitle?: string;
}

const SITE_URL = "https://www.perscon.com.mx";
const SITE_NAME = "Perscon";
const SITE_DESC = "Asesoría Regulatoria y Trámites COFEPRIS en México";
const PHONE = "+52-55-7911-3086";
const EMAIL = "contacto@perscon.com.mx";

const {
  title,
  description,
  canonical = Astro.url.href,
  ogImage = "/og/og-default.webp",
  ogType = "website",
  noindex = false,
  nofollow = false,
  breadcrumbs = [],
  pageSchema,
  ogLocale = "es_MX",
  articleAuthor,
  articlePublishedTime,
  articleModifiedTime,
  articleSection,
  bodyClass = "",
  ogTitle,
} = Astro.props;

const fullTitle = `${title} | ${SITE_NAME}`;
const ogPageTitle = ogTitle || title;
const canonicalUrl = canonical.startsWith("http")
  ? canonical
  : `${SITE_URL}${canonical}`;

// OG Image: validar y construir URL completa
const validateOgImage = (image: string): string => {
  if (!image) return `${SITE_URL}/og/og-default.webp`;
  if (image.startsWith("http")) return image;
  if (image.startsWith("/")) return `${SITE_URL}${image}`;
  return `${SITE_URL}/${image}`;
};

const ogImageUrl = validateOgImage(ogImage);

const robotsContent = [
  noindex ? "noindex" : "index",
  nofollow ? "nofollow" : "follow",
].join(", ");

// Breadcrumbs
const allBreadcrumbs = [
  { name: "Inicio", url: `${SITE_URL}/` },
  ...breadcrumbs.map((b) => ({
    name: b.name,
    url: b.url.startsWith("http") ? b.url : `${SITE_URL}${b.url}`,
  })),
];

// ─── SCHEMAS ─────────────────────────

// Organization
const schemaOrganization = {
  "@context": "https://schema.org",
  "@type": ["Organization", "ProfessionalService"],
  "@id": `${SITE_URL}/#organization`,
  name: SITE_NAME,
  url: SITE_URL,
  foundingDate: "2015",
  logo: {
    "@type": "ImageObject",
    url: `${SITE_URL}/og/logo.png`,
  },
  image: {
    "@type": "ImageObject",
    url: `${SITE_URL}/og/og-default.webp`,
  },
  description: SITE_DESC,
  telephone: PHONE,
  email: EMAIL,
  address: {
    "@type": "PostalAddress",
    streetAddress: "Sor Juana Ines de la Cruz Manzana 032 Lote Teléfo",
    addressLocality: "Ricardo Flores Magon",
    postalCode: "54607",
    addressRegion: "Tepotzotlán",
    addressCountry: "MX",
  },
  areaServed: [
    {
      "@type": "State",
      name: "Estado de México",
    },
    {
      "@type": "Country",
      name: "México",
    },
  ],
  contactPoint: {
    "@type": "ContactPoint",
    contactType: "Customer Support",
    telephone: PHONE,
    email: EMAIL,
  },
  inLanguage: "es-MX",
  sameAs: [
    "https://www.linkedin.com/company/perscon",
    "https://www.facebook.com/perscon",
  ],
  geo: {
    "@type": "GeoCoordinates",
    latitude: 19.8126,
    longitude: -99.3514,
  },
  openingHoursSpecification: {
    "@type": "OpeningHoursSpecification",
    dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
    opens: "09:00",
    closes: "18:00",
  },
  priceRange: "$$$",
};

// Website
const schemaWebSite = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${SITE_URL}/#website`,
  url: SITE_URL,
  name: SITE_NAME,
  description: SITE_DESC,
  publisher: { "@id": `${SITE_URL}/#organization` },
  inLanguage: "es-MX",
};

// WebPage / Article
const schemaWebPage = {
  "@context": "https://schema.org",
  "@type": ogType === "article" ? "Article" : "WebPage",
  "@id": `${canonicalUrl}#webpage`,
  url: canonicalUrl,
  name: fullTitle,
  description,
  isPartOf: { "@id": `${SITE_URL}/#website` },
  publisher: { "@id": `${SITE_URL}/#organization` },
  inLanguage: "es-MX",
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": canonicalUrl,
  },
  ...(articlePublishedTime && { datePublished: articlePublishedTime }),
  ...(articleModifiedTime && { dateModified: articleModifiedTime }),
  ...(articleAuthor && {
    author: {
      "@type": "Organization",
      "@id": `${SITE_URL}/#organization`,
      name: articleAuthor,
      url: SITE_URL,
    },
  }),
  ...(ogImageUrl && {
    primaryImageOfPage: {
      "@type": "ImageObject",
      url: ogImageUrl,
    },
  }),
};

// Breadcrumb
const schemaBreadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "@id": `${canonicalUrl}#breadcrumb`,
  itemListElement: allBreadcrumbs.map((item, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: item.name,
    item: {
      "@id": item.url,
    },
  })),
};

// Extra schemas
const extraSchemas = pageSchema
  ? Array.isArray(pageSchema)
    ? pageSchema
    : [pageSchema]
  : [];

// Final array
const allSchemas = [
  schemaOrganization,
  schemaWebSite,
  schemaWebPage,
  schemaBreadcrumb,
  ...extraSchemas,
];
---

<!doctype html>
<html lang="es-MX">
  <head>

    <script is:inline>
			(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
			new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
			j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
			'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
			})(window,document,'script','dataLayer','GTM-TGPV253D');
		</script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <meta name="robots" content={robotsContent} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content={ogLocale} />

    <!-- Open Graph Meta Tags -->
    <meta property="og:title" content={ogPageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/webp" />
    <meta property="og:image:alt" content={`${ogPageTitle} — ${SITE_NAME}`} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogPageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Article Specific OG Tags -->
    {ogType === "article" && articlePublishedTime && (
      <meta property="article:published_time" content={articlePublishedTime} />
    )}
    {ogType === "article" && articleModifiedTime && (
      <meta property="article:modified_time" content={articleModifiedTime} />
    )}
    {ogType === "article" && articleAuthor && (
      <meta property="article:author" content={articleAuthor} />
    )}
    {ogType === "article" && articleSection && (
      <meta property="article:section" content={articleSection} />
    )}

    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta name="theme-color" content="#ffffff" />

    <!-- Schemas -->
    {
      allSchemas.map((schema) => (
        <script type="application/ld+json" set:html={JSON.stringify(schema)} />
      ))
    }

  </head>

  <body class={bodyClass}>
    <noscript>
			<iframe 
				src="https://www.googletagmanager.com/ns.html?id=GTM-TGPV253D"
				height="0" width="0" style="display:none;visibility:hidden">
			</iframe>
		</noscript>
    <Header />
    <WhatsAppFloat />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <CookieBanner />
  </body>
</html>
